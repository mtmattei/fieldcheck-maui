<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <PropertyGroup>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FieldCheck.Core\FieldCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests read the real benchmark fixtures (read-only) and verify they are never mutated. -->
    <None Include="..\..\..\mock-data\assets.json" Link="fixtures\assets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\mock-data\inspections.json" Link="fixtures\inspections.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
