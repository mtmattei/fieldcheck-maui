<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout
    x:Class="FieldCheck.Controls.StatePanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Padding="0,32"
    Spacing="8">
    <ActivityIndicator x:Name="Spinner" IsVisible="False" IsRunning="False" HorizontalOptions="Start" WidthRequest="28" HeightRequest="28" />
    <Label x:Name="TitleLabel" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Label x:Name="MessageLabel" Style="{StaticResource SecondaryText}" FontSize="14" MaximumWidthRequest="460" HorizontalOptions="Start" />
    <Button
        x:Name="ActionButton"
        AutomationId="StateActionButton"
        Margin="0,12,0,0"
        Style="{StaticResource SecondaryButton}"
        HeightRequest="48"
        HorizontalOptions="Start"
        IsVisible="False" />
</VerticalStackLayout>
