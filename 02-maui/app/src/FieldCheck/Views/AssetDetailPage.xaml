<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FieldCheck.Views.AssetDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FieldCheck.Core.ViewModels;assembly=FieldCheck.Core"
    xmlns:views="clr-namespace:FieldCheck.Views"
    x:DataType="vm:AssetDetailViewModel"
    Title="Asset detail"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Padding="{OnPlatform Default='8,40,20,8', WinUI='28,36,40,8'}" Spacing="6">
            <ImageButton
                Source="icon_back.png"
                Style="{StaticResource IconButton}"
                Command="{Binding BackCommand}"
                SemanticProperties.Description="Back" />
            <Label Text="Asset detail" Style="{StaticResource ScreenTitle}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <views:AssetDetailView x:Name="DetailView" Padding="{OnPlatform Default='20,16,20,0', WinUI='40,24,40,0'}" />
        </ScrollView>
    </Grid>
</ContentPage>
