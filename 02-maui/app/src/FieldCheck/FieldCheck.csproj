<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Platform-neutral TFM used only to compile-check shared code and XAML on hosts without platform SDKs
		     (documented MAUI unit-testing pattern). Opt in with -p:IncludeNeutralTfm=true. -->
		<TargetFrameworks Condition="'$(IncludeNeutralTfm)' == 'true'">$(TargetFrameworks);net10.0</TargetFrameworks>

		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
		<RootNamespace>FieldCheck</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>

		<ApplicationTitle>FieldCheck</ApplicationTitle>
		<ApplicationId>com.fieldcheck.app</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<!-- Unpackaged app ships the Windows App SDK runtime so it runs without a separate runtime install. -->
		<WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#171918" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F3F2ED" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />

		<!-- Benchmark fixtures are bundled read-only and copied into app storage on first run. -->
		<MauiAsset Include="..\..\..\mock-data\assets.json" LogicalName="seed/assets.json" />
		<MauiAsset Include="..\..\..\mock-data\inspections.json" LogicalName="seed/inspections.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FieldCheck.Core\FieldCheck.Core.csproj" />
	</ItemGroup>

</Project>
