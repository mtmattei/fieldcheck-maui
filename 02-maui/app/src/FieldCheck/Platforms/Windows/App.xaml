<maui:MauiWinUIApplication
    x:Class="FieldCheck.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:FieldCheck.WinUI">
    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- The sidebar item template draws its own Accent marker; hide the native NavigationView pill. -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>
